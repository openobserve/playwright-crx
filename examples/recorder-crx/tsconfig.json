{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "useUnknownInCatchVariables": false,
    "paths": {
      // 1.60 moved isomorphic and utils out of playwright-core into top-level packages.
      "@isomorphic/*": ["../../playwright/packages/isomorphic/*"],
      "@utils/*": ["../../playwright/packages/utils/*"],
      "@protocol/*": ["../../playwright/packages/protocol/src/*"],
      "@web/*": ["../../playwright/packages/web/src/*"],
      "@recorder/*": ["../../playwright/packages/recorder/src/*"],
      // Installing playwright's own dependencies (1.60 needs them — see
      // ci:pw:bundles) put a second React beside ours: 19.2 there against 18.3 here.
      // The vendored .tsx we compile resolves its React types from playwright's copy
      // and ours from this one, and two React type identities make every vendored
      // component "cannot be used as a JSX component". Pin both to the copy we render
      // with, which is the one that ends up in the bundle.
      "react": ["../../node_modules/react"],
      // The wildcard matters as much as the bare name: jsx: "react-jsx" imports
      // react/jsx-runtime, which an exact "react" mapping does not match, so the
      // JSX namespace kept coming from the other copy.
      "react/*": ["../../node_modules/react/*"],
      "react-dom": ["../../node_modules/react-dom"],
      "react-dom/*": ["../../node_modules/react-dom/*"],
      "@types/react": ["../../node_modules/@types/react"],
    }
  },
  "include": ["src"],
}
